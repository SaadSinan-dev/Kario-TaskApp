# ---------------------------------------------------------------------------
# Kairo — environment configuration
#
# Flutter has no runtime .env: configuration is compile-time and arrives via
# --dart-define. This file documents the full set of variables and their
# defaults so nothing has to be guessed.
#
# NEVER commit real values. Only *publishable* keys belong on a client at all;
# anything secret (payment secret keys, database URLs, mail tokens) lives on a
# server.
# ---------------------------------------------------------------------------

# Which environment this build represents.
#   development | staging | production
KAIRO_FLAVOR=development

# Base URL of the REST API, used once a real backend is wired up.
KAIRO_API_BASE_URL=https://api.kairo.app/v1

# When true the app runs entirely against the local repository stack. This is
# what powers the offline demo and every test run.
KAIRO_USE_MOCK_DATA=true

# Simulated network latency in milliseconds for the local data source. Keeps
# loading and skeleton states honest during development instead of never being
# seen. Set to 0 for tests and demos.
KAIRO_MOCK_LATENCY_MS=260

# Product analytics. Only honoured in production builds.
KAIRO_ENABLE_ANALYTICS=false

# Stripe publishable (client-safe) key. The secret key must never appear here.
KAIRO_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
#
#   flutter run -d chrome \
#     --dart-define=KAIRO_FLAVOR=staging \
#     --dart-define=KAIRO_MOCK_LATENCY_MS=0
#
#   flutter build web --release \
#     --dart-define=KAIRO_FLAVOR=production \
#     --dart-define=KAIRO_ENABLE_ANALYTICS=true
#
# In CI, prefer --dart-define-from-file with a JSON file injected from your
# secret store rather than passing values on the command line.
# ---------------------------------------------------------------------------
