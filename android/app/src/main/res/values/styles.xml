<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, before the Flutter engine draws. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process is running; also the colour behind the
         Flutter UI, so it must match the app canvas. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/kairo_canvas</item>
    </style>
</resources>
