<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ in dark mode. Same structure as values-v31; the colours come
     from values-night/colors.xml, so the splash follows the system theme the
     same way the Flutter splash does. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/kairo_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/kairo_splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/kairo_canvas</item>
    </style>
</resources>
