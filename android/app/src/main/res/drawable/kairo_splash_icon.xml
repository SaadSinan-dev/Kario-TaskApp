<?xml version="1.0" encoding="utf-8"?>
<!-- The Kairo mark for the Android 12+ splash screen.

     A near-closed orbit with a solid dot at its leading end — the same shape
     `BrandMark` paints in Dart, redrawn as a vector so the platform splash and
     the Flutter splash show the same logo.

     The platform masks this to a circle and scales it into the inner 2/3 of a
     108dp canvas, so the artwork is drawn on a 108x108 grid centred at 54,54. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The 250° arc. Stroked with round caps, matching the Dart painter. -->
    <path
        android:pathData="M 34.8,71.6 A 24,24 0 1 1 71.2,73.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- The dot that closes the gap. -->
    <path
        android:pathData="M 71.2,73.6 m -5.2,0 a 5.2,5.2 0 1,0 10.4,0 a 5.2,5.2 0 1,0 -10.4,0"
        android:fillColor="#FFFFFF" />
</vector>
